  "typography": {
    "files": {
      "dir": "web/public/fonts",
      "display": "google-sans-flex-display.woff2",
      "sans": "google-sans-text.woff2",
      "mono": "google-sans-code.woff2",
      "licence": "OFL-1.1 (OFL-google-sans*.txt next to the files)",
      "preload": "display only"
    },
    "families": {
      "sans": {
        "family": "Google Sans",
        "weights": [
          400,
          500,
          600
        ],
        "stack": "\"Google Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
      },
      "mono": {
        "family": "Google Sans Code",
        "weights": [
          400,
          500,
          600
        ],
        "stack": "\"Google Sans Code\", ui-monospace, \"SF Mono\", \"Cascadia Mono\", Menlo, Consolas, monospace"
      },
      "display": {
        "family": "Google Sans Flex",
        "weights": [
          570
        ],
        "stack": "\"Google Sans Flex\", \"Google Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
      }
    },
    "scale": [
      {
        "token": "display",
        "size": "48px",
        "lineHeight": "52px",
        "weight": 570,
        "tracking": "-0.012em",
        "family": "display",
        "use": "marketing, report cover"
      },
      {
        "token": "kpi",
        "size": "36px",
        "lineHeight": "40px",
        "weight": 570,
        "tracking": "-0.012em",
        "family": "display",
        "use": "hero figure (the one highlighted figure; may carry the mark bar)"
      },
      {
        "token": "h1",
        "size": "28px",
        "lineHeight": "34px",
        "weight": 570,
        "tracking": "-0.012em",
        "family": "display",
        "use": "page title"
      },
      {
        "token": "stat",
        "size": "24px",
        "lineHeight": "32px",
        "weight": 570,
        "tracking": "-0.012em",
        "family": "display",
        "use": "KPI tile value"
      },
      {
        "token": "h2",
        "size": "18px",
        "lineHeight": "26px",
        "weight": 600,
        "tracking": "-0.006em",
        "family": "sans",
        "use": "section title"
      },
      {
        "token": "h3",
        "size": "16px",
        "lineHeight": "24px",
        "weight": 600,
        "tracking": "0",
        "family": "sans",
        "use": "card title"
      },
      {
        "token": "body",
        "size": "14px",
        "lineHeight": "20px",
        "weight": 400,
        "tracking": "0",
        "family": "sans",
        "use": "default UI text"
      },
      {
        "token": "body-lg",
        "size": "16px",
        "lineHeight": "24px",
        "weight": 400,
        "tracking": "0",
        "family": "sans",
        "use": "AI answer transcripts, reports"
      },
      {
        "token": "small",
        "size": "13px",
        "lineHeight": "18px",
        "weight": 400,
        "tracking": "0",
        "family": "sans",
        "use": "table cells, secondary"
      },
      {
        "token": "caption",
        "size": "12px",
        "lineHeight": "16px",
        "weight": 500,
        "tracking": "0",
        "family": "sans",
        "use": "labels, legends, table heads, badges, axis ticks (sentence case, never uppercase)"
      },
      {
        "token": "code",
        "size": "13px",
        "lineHeight": "20px",
        "weight": 400,
        "tracking": "0",
        "family": "mono",
        "use": "numbers in tables, deltas, user agents, llms.txt, ids"
      }
    ],
    "rules": "Weights 400, 500, 600; display 570. Sentence case everywhere: no uppercase labels, no letter-spaced caps. Tabular numerals for every figure (tnum)."
  },
  "radii": {
    "xs": "1px",
    "sm": "2px",
    "md": "4px",
    "lg": "6px",
    "xl": "6px",
    "use": {
      "xs": "cells",
      "sm": "chips, tags, code, checkbox",
      "md": "buttons, inputs",
      "lg": "cards, panels, popovers, dialogs"
    },
    "full": "status dots only"
  },
  "shadows": {
    "rest": "none",
    "overlay": {
      "light": "0 16px 48px rgb(7 21 41 / 0.14)",
      "dark": "0 16px 48px rgb(2 8 18 / 0.55)"
    },
    "use": "menus, popovers, tooltips, dialogs, drawers, toasts"
  },
  "motion": {
    "fast": "160ms",
    "base": "220ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "none"
  },
  "iconography": {
    "library": "lucide-react",
    "strokeWidth": 1.75,
    "sizes": [
      14,
      16,
      20,
      24
    ]
  }
}
