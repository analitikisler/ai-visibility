# Copy to .env (repo root) or server/.env, or export in your shell. Every key is optional:
# engines without a key run in deterministic "simulated" mode. Keys can also be set in the app (Settings).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional model overrides
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# GEMINI_MODEL=
# PERPLEXITY_MODEL=
# XAI_MODEL=
# DEEPSEEK_MODEL=

# Server
PORT=4400
# Protect the workspace with basic auth (ingestion, pixel and health stay public)
# APP_USER=
# APP_PASSWORD=
# Without auth, only loopback hosts can open the workspace; add others here (comma-separated)
# ALLOWED_HOSTS=
# DATA_DIR=./server/data
# DB_PATH=./server/data/app.db
# Scheduled checks only run in production (npm start); set to "on" to run them under npm run dev too
# SCHEDULER=on

# Cost controls (defaults shown; Workspace settings override them)
# MONTHLY_BUDGET_USD=20
# SCHEDULED_MODE=batch
# REUSE_SAME_DAY=1

# Cloudflare hosting only (deploy/cloudflare/README.md): R2 credentials for Litestream backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
