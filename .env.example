# Copy to .env (repo root) or server/.env, or export in your shell. Every key is optional:
# engines without a key run in deterministic "simulated" mode. Keys can also be set in the app (Settings).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional model overrides
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# GEMINI_MODEL=
# PERPLEXITY_MODEL=

# Server
PORT=4400
# Protect the workspace with basic auth (ingestion, pixel and health stay public)
# APP_USER=
# APP_PASSWORD=
# Without auth, only loopback hosts can open the workspace; add others here (comma-separated)
# ALLOWED_HOSTS=
# DATA_DIR=./server/data

# Cloudflare hosting only (deploy/cloudflare/README.md): R2 credentials for Litestream backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
