{
  "name": "ai-visibility",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "check:live": "npm run check:live -w server --"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "concurrently": "^9.2.5",
    "jose": "^6.2.13",
    "wrangler": "^4.152.0"
  }
}
